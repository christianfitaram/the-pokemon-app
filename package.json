{
  "name": "the-pokemon-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:strict": "next lint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "cypress run",
    "warm:cache": "ts-node --esm utils/warmCache.ts",
    "warm:types": "ts-node --esm utils/warmTypes.ts",
    "warm:redis": "npm run warm:cache && npm run warm:types",
    "test:security": "node scripts/test-security.js",
    "build:prod": "NODE_ENV=production next build",
    "start:prod": "NODE_ENV=production next start"
  },
  "dependencies": {
    "dotenv": "^17.2.1",
    "framer-motion": "^12.6.2",
    "lucide-react": "^0.539.0",
    "marked": "^16.1.1",
    "next": "^15.5.15",
    "openai": "^5.10.2",
    "pg": "^8.16.3",
    "react": "^18",
    "react-dom": "^18",
    "react-icons": "^5.5.0",
    "redis": "^5.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.7.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.15.5",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "css-loader": "^7.1.2",
    "cypress": "^14.5.4",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.15",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.0.5",
    "postcss": "^8",
    "style-loader": "^4.0.0",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
